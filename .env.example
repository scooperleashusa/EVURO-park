# Cloudflare API Configuration
# Copy this file to .env and fill in your actual API credentials
# DO NOT commit the .env file to version control

# Cloudflare API Token
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID (optional)
# Find this in your Cloudflare dashboard
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Zone ID (optional)
# Find this in your domain settings
CF_ZONE_ID=your_cloudflare_zone_id_here
